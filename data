<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#f6f7f2">
  <title>Gather — your grocery list</title>
  <style>
    :root {
      color-scheme: light;
      --ink: #192a24;
      --muted: #78827b;
      --green: #245c43;
      --green-dark: #194733;
      --mint: #e6f0e9;
      --paper: #fff;
      --canvas: #f6f7f2;
      --line: #e9ece6;
      --orange: #e89058;
      --shadow: 0 18px 55px rgba(30, 55, 42, .08);
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      min-width: 320px;
      min-height: 100vh;
      background:
        radial-gradient(ellipse at 86% 4%, rgba(226, 237, 220, .7), transparent 31rem),
        var(--canvas);
      color: var(--ink);
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      -webkit-font-smoothing: antialiased;
    }

    button, input, select { font: inherit; }
    button { color: inherit; }
    button:focus-visible, input:focus-visible, select:focus-visible {
      outline: 3px solid rgba(54, 126, 87, .35);
      outline-offset: 3px;
    }

    .page { width: min(1050px, calc(100% - 40px)); margin: 0 auto; padding: 28px 0 52px; }
    .topbar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 36px; }
    .brand { display: flex; gap: 11px; align-items: center; font-weight: 780; letter-spacing: -.04em; font-size: 21px; }
    .brand-mark {
      display: grid; width: 38px; height: 38px; place-items: center; border-radius: 13px;
      background: var(--green); color: white; box-shadow: 0 5px 12px rgba(36, 92, 67, .18);
    }
    .brand-mark svg { width: 22px; height: 22px; }
    .today { color: var(--muted); font-size: 13px; font-weight: 560; }

    .layout { display: grid; grid-template-columns: minmax(0, 1fr) 286px; gap: 24px; align-items: start; }
    .main-card, .side-card { background: var(--paper); border: 1px solid rgba(230, 234, 227, .9); border-radius: 22px; box-shadow: var(--shadow); }
    .main-card { overflow: hidden; }
    .hero { padding: 30px 32px 26px; background: linear-gradient(110deg, #edf4ed, #f8f8f1 78%); }
    .eyebrow { color: var(--green); font-size: 11px; font-weight: 800; letter-spacing: .13em; text-transform: uppercase; }
    h1 { margin: 9px 0 5px; font-size: clamp(29px, 4vw, 37px); letter-spacing: -.055em; line-height: 1.12; }
    .subtitle { margin: 0; color: #64736a; font-size: 14px; }
    .progress-block { margin-top: 23px; }
    .progress-copy { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 9px; font-size: 12px; }
    .progress-copy strong { color: var(--green); font-size: 13px; }
    .progress-track { height: 8px; overflow: hidden; border-radius: 99px; background: #dce5dc; }
    .progress-fill { width: 0; height: 100%; border-radius: inherit; background: var(--green); transition: width .3s ease; }

    .add-form { display: grid; grid-template-columns: minmax(0, 1fr) 86px 68px; gap: 9px; padding: 20px 24px; border-bottom: 1px solid var(--line); }
    .field { width: 100%; min-width: 0; height: 44px; padding: 0 13px; border: 1px solid #e3e8e1; border-radius: 11px; background: #fff; color: var(--ink); }
    .field::placeholder { color: #a0aaa2; }
    .store-picker-label { grid-column: 1 / -1; margin: 4px 0 -3px; color: #64736a; font-size: 11px; font-weight: 700; }
    .store-picker { grid-column: 1 / -1; display: flex; gap: 8px; overflow-x: auto; padding: 2px 0 7px; overscroll-behavior-x: contain; scroll-snap-type: x proximity; scrollbar-width: thin; -webkit-overflow-scrolling: touch; }
    .store-option { display: flex; flex: 0 0 auto; min-height: 48px; align-items: center; gap: 8px; padding: 6px 10px; border: 1px solid #e8ece6; border-radius: 12px; background: #fff; cursor: pointer; scroll-snap-align: start; transition: .15s; }
    .store-option:hover { border-color: #cbd8cc; background: #f8faf7; }
    .store-option[aria-pressed="true"] { border-color: var(--green); background: var(--mint); box-shadow: inset 0 0 0 1px var(--green); }
    .store-option img { display: block; flex: 0 0 32px; width: 32px; height: 32px; object-fit: contain; }
    .store-option .pharmacy-symbol { display: grid; flex: 0 0 32px; width: 32px; height: 32px; place-items: center; color: #34805c; font-size: 27px; line-height: 1; }
    .store-option span { white-space: nowrap; color: #536159; font-size: 11px; font-weight: 680; line-height: 1.15; }
    .store-option[aria-pressed="true"] span { color: var(--green); }
    .add-button { grid-column: 3; grid-row: 1; display: flex; align-items: center; justify-content: center; gap: 4px; border: 0; border-radius: 11px; background: var(--green); color: #fff; font-size: 12px; font-weight: 680; cursor: pointer; transition: background .16s, transform .16s; }
    .add-button:hover { background: var(--green-dark); transform: translateY(-1px); }
    .add-button svg { width: 18px; height: 18px; }

    .toolbar { display: flex; justify-content: space-between; align-items: center; gap: 14px; padding: 17px 24px 12px; }
    .filters { display: flex; gap: 5px; }
    .filter-button { padding: 8px 12px; border: 0; border-radius: 9px; background: transparent; color: var(--muted); font-size: 12px; font-weight: 650; cursor: pointer; }
    .filter-button:hover { background: #f5f7f3; color: var(--ink); }
    .filter-button[aria-pressed="true"] { background: var(--mint); color: var(--green); }
    .search-wrap { position: relative; width: min(200px, 42%); }
    .search-wrap svg { position: absolute; top: 50%; left: 11px; width: 15px; height: 15px; color: #909b92; transform: translateY(-50%); pointer-events: none; }
    .search { height: 36px; padding: 0 10px 0 33px; border: 1px solid #e8ece6; border-radius: 9px; background: #fbfcfa; font-size: 12px; }

    .list { padding: 0 24px 16px; }
    .store-group { margin-top: 10px; }
    .store-heading { display: flex; align-items: center; gap: 9px; padding: 13px 0 7px; color: #738078; font-size: 10px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
    .store-logo { flex: 0 0 36px; width: 36px; height: 28px; object-fit: contain; }
    .store-logo.pharmacy-symbol { display: grid; place-items: center; color: #34805c; font-size: 25px; line-height: 1; }
    .store-count { margin-left: auto; font-size: 10px; font-weight: 650; letter-spacing: 0; }
    .item-row { min-height: 57px; display: flex; align-items: center; gap: 12px; border-bottom: 1px solid #f0f2ee; animation: appear .18s ease-out; }
    @keyframes appear { from { opacity: 0; transform: translateY(3px); } to { opacity: 1; transform: translateY(0); } }
    .check-wrap { position: relative; display: grid; flex: 0 0 22px; width: 22px; height: 22px; place-items: center; }
    .check-wrap input { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: pointer; }
    .checkmark { display: grid; width: 21px; height: 21px; place-items: center; border: 1.5px solid #cbd4cc; border-radius: 7px; color: transparent; transition: .15s ease; pointer-events: none; }
    .checkmark svg { width: 13px; height: 13px; }
    .check-wrap input:focus-visible + .checkmark { outline: 3px solid rgba(54, 126, 87, .35); outline-offset: 3px; }
    .check-wrap input:checked + .checkmark { border-color: var(--green); background: var(--green); color: #fff; }
    .item-name { min-width: 0; flex: 1; font-size: 14px; font-weight: 570; transition: color .16s; }
    .item-row.is-bought .item-name { color: #9aa39c; text-decoration: line-through; text-decoration-thickness: 1.5px; }
    .quantity { color: #88938a; font-size: 11px; white-space: nowrap; }
    .remove-button { display: grid; width: 32px; height: 32px; place-items: center; border: 0; border-radius: 9px; background: transparent; color: #a2aaa3; cursor: pointer; opacity: 0; transition: .15s; }
    .item-row:hover .remove-button, .remove-button:focus-visible { opacity: 1; }
    .remove-button:hover { background: #fff0ec; color: #b95842; }
    .remove-button svg { width: 16px; height: 16px; }
    .empty-state { padding: 35px 12px 42px; text-align: center; color: var(--muted); }
    .empty-icon { display: grid; width: 48px; height: 48px; margin: 0 auto 12px; place-items: center; border-radius: 16px; background: #f0f5ef; font-size: 22px; }
    .empty-state strong { display: block; margin-bottom: 5px; color: var(--ink); font-size: 14px; }
    .empty-state span { font-size: 12px; }

    .side-card { padding: 23px; }
    .side-title { margin: 0 0 18px; font-size: 14px; font-weight: 760; letter-spacing: -.02em; }
    .stats { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
    .stat { min-height: 94px; padding: 15px 13px; border-radius: 14px; background: #f6f8f4; }
    .stat-number { display: block; margin-bottom: 6px; font-size: 27px; font-weight: 770; letter-spacing: -.06em; line-height: 1; }
    .stat-label { color: var(--muted); font-size: 11px; font-weight: 560; }
    .stat.done { background: #eaf3ec; }
    .stat.done .stat-number { color: var(--green); }
    .stat.left .stat-number { color: #c47a47; }
    .side-divider { height: 1px; margin: 20px 0; background: var(--line); }
    .tip { display: flex; gap: 11px; padding: 13px; border-radius: 13px; background: #fbf5e9; }
    .tip-icon { flex: 0 0 auto; font-size: 17px; }
    .tip p { margin: 0; color: #73664e; font-size: 11px; line-height: 1.55; }
    .tip strong { display: block; margin-bottom: 2px; color: #554a35; font-size: 12px; }
    .side-actions { display: grid; gap: 8px; margin-top: 18px; }
    .text-action { padding: 10px; border: 1px solid #e8ece6; border-radius: 10px; background: white; color: #59665d; font-size: 12px; font-weight: 620; cursor: pointer; transition: .15s; }
    .text-action:hover { border-color: #cbd8cc; background: #f8faf7; }
    .text-action.danger:hover { border-color: #f0d4cb; background: #fff8f5; color: #a65340; }
    .backup-options { margin-top: 12px; }
    .backup-options summary { width: fit-content; color: var(--muted); font-size: 11px; cursor: pointer; }
    .backup-actions { display: grid; gap: 7px; margin-top: 9px; }
    .footnote { margin: 19px 3px 0; color: #9aa39b; font-size: 10px; line-height: 1.6; text-align: center; }
    .toast { position: fixed; right: 22px; bottom: 22px; z-index: 3; max-width: min(360px, calc(100vw - 32px)); padding: 12px 16px; border-radius: 12px; background: #203c2e; box-shadow: 0 12px 28px rgba(25, 50, 35, .2); color: white; font-size: 13px; opacity: 0; transform: translateY(8px); pointer-events: none; transition: .2s ease; }
    .toast.show { opacity: 1; transform: translateY(0); }
    .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }

    @media (max-width: 760px) {
      .page { width: min(620px, calc(100% - 28px)); padding-top: 17px; }
      .topbar { margin-bottom: 22px; }
      .layout { grid-template-columns: 1fr; gap: 15px; }
      .side-card { padding: 17px; }
      .side-title { margin-bottom: 12px; }
      .stats { grid-template-columns: repeat(3, 1fr); gap: 8px; }
      .stat { min-height: 75px; padding: 12px; }
      .stat-number { font-size: 24px; }
      .side-divider, .tip, .footnote { display: none; }
      .side-actions { grid-template-columns: 1fr 1fr; margin-top: 11px; }
    }
    @media (max-width: 520px) {
      .page { width: calc(100% - 20px); padding: 12px 0 30px; }
      .topbar { margin: 0 3px 15px; }
      .brand { font-size: 19px; }
      .brand-mark { width: 35px; height: 35px; }
      .today { font-size: 11px; }
      .main-card, .side-card { border-radius: 17px; }
      .hero { padding: 23px 20px 20px; }
      .add-form { grid-template-columns: minmax(0, 1fr) 66px 62px; gap: 7px; padding: 14px; }
      .add-form .add-button { grid-column: 3; grid-row: 1; }
      .field { height: 42px; }
      .toolbar { flex-wrap: wrap; padding: 13px 15px 9px; }
      .filters { gap: 0; }
      .filter-button { padding: 8px 10px; font-size: 11px; }
      .search-wrap { width: 100%; }
      .search { width: 100%; }
      .list { padding: 0 16px 13px; }
      .item-row { min-height: 55px; }
      .remove-button { opacity: 1; }
      .store-heading { padding-top: 12px; }
    }
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { scroll-behavior: auto !important; animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; }
    }
  </style>
</head>
<body>
  <div class="page">
    <header class="topbar">
      <div class="brand">
        <span class="brand-mark" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none"><path d="M4 8.5h16l-1.4 11H5.4L4 8.5Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="m8 9 4-6 4 6M8 13v3m4-3v3m4-3v3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
        Gather
      </div>
      <time class="today" id="today"></time>
    </header>

    <main class="layout">
      <section class="main-card" aria-labelledby="list-title">
        <div class="hero">
          <div class="eyebrow">Your shopping list</div>
          <h1 id="list-title">A little less to remember.</h1>
          <p class="subtitle" id="subtitle">Tap an item when it’s in your basket. You’ve got this.</p>
          <div class="progress-block">
            <div class="progress-copy"><span id="progress-label">Your progress</span><strong id="progress-percent">0%</strong></div>
            <div class="progress-track" id="progress-track" role="progressbar" aria-label="Shopping progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
              <div class="progress-fill" id="progress-fill"></div>
            </div>
          </div>
        </div>

        <form class="add-form" id="add-form">
          <label class="sr-only" for="item-input">Add a grocery item</label>
          <input class="field" id="item-input" name="name" placeholder="Add an item..." maxlength="70" autocomplete="off" required>
          <label class="sr-only" for="quantity-input">Quantity</label>
          <input class="field" id="quantity-input" name="quantity" type="number" min="1" max="99" value="1" aria-label="Quantity">
          <input type="hidden" id="store-input" name="store" value="Lidl">
          <div class="store-picker-label">Choose a store</div>
          <div class="store-picker" id="store-picker" role="group" aria-label="Choose a store"></div>
          <button class="add-button" type="submit" aria-label="Add item">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            <span>Add</span>
          </button>
        </form>

        <div class="toolbar">
          <div class="filters" role="group" aria-label="Filter list">
            <button type="button" class="filter-button" data-filter="all" aria-pressed="true">All <span id="all-count"></span></button>
            <button type="button" class="filter-button" data-filter="left" aria-pressed="false">To get <span id="left-count"></span></button>
            <button type="button" class="filter-button" data-filter="bought" aria-pressed="false">Got it <span id="bought-count"></span></button>
          </div>
          <label class="search-wrap">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8" stroke="currentColor" stroke-width="1.8"/><path d="m16 16 4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
            <span class="sr-only">Search your list</span>
            <input class="field search" id="search-input" type="search" placeholder="Find an item..." autocomplete="off">
          </label>
        </div>
        <div class="list" id="list" aria-live="polite"></div>
      </section>

      <aside class="side-card" aria-labelledby="summary-title">
        <h2 class="side-title" id="summary-title">The little tally</h2>
        <div class="stats">
          <div class="stat done"><span class="stat-number" id="stat-bought">0</span><span class="stat-label">Picked up</span></div>
          <div class="stat left"><span class="stat-number" id="stat-left">0</span><span class="stat-label">Still to get</span></div>
          <div class="stat"><span class="stat-number" id="stat-total">0</span><span class="stat-label">On your list</span></div>
        </div>
        <div class="side-divider"></div>
        <div class="tip">
          <span class="tip-icon" aria-hidden="true">🌿</span>
          <p><strong>Little tip</strong>Check things off as they go in your basket. Your progress saves in this browser. Export a backup before removing this file.</p>
        </div>
        <div class="side-actions">
          <button type="button" class="text-action" id="clear-list">Clear list</button>
          <button type="button" class="text-action danger" id="new-list">Start fresh</button>
        </div>
        <details class="backup-options">
          <summary>Backup / restore</summary>
          <div class="backup-actions">
            <button type="button" class="text-action" id="export-list">Export backup</button>
            <button type="button" class="text-action" id="import-list">Import backup</button>
          </div>
        </details>
        <input type="file" id="backup-file" accept="application/json,.json" hidden>
        <p class="footnote">Your list stays in this browser. Export a backup before replacing or removing this file.</p>
      </aside>
    </main>
  </div>
  <div class="toast" id="toast" role="status" aria-live="polite"></div>

  <script>
    (function () {
      "use strict";
      const STORAGE_KEY = "Gather-grocery-list-v1";
      const INITIALIZED_KEY = "Gather-empty-start-initialized-v1";
      const stores = [
        { name: "Lidl", logoUrl: "data:image/svg+xml;base64," },
        { name: "Colruyt", logoUrl: "data:image/x-icon;base64," },
        { name: "AH", logoUrl: "data:image/png;base64," },
        { name: "Action", logoUrl: "data:image/png;base64," },
        { name: "Bima (Turkish store)", logoUrl: "" },
        { name: "Pharmacy", logoUrl: "", logoType: "pharmacy" },
        { name: "Other", logoUrl: "" }
      ];
      const listElement = document.getElementById("list");
      const form = document.getElementById("add-form");
      const itemInput = document.getElementById("item-input");
      const quantityInput = document.getElementById("quantity-input");
      const storeInput = document.getElementById("store-input");
      const storePicker = document.getElementById("store-picker");
      const searchInput = document.getElementById("search-input");
      const toastElement = document.getElementById("toast");
      const storeButtons = [];
      let activeFilter = "all";
      let searchTerm = "";
      let toastTimer;
      let items = loadItems();

      function createStoreLogo(store, className) {
        if (store.logoType === "pharmacy") {
          const symbol = document.createElement("span");
          symbol.className = className + " pharmacy-symbol";
          symbol.textContent = "✚";
          symbol.setAttribute("aria-hidden", "true");
          return symbol;
        }
        if (!store.logoUrl) return null;
        const logo = document.createElement("img");
        logo.className = className;
        logo.src = store.logoUrl;
        logo.alt = "";
        logo.setAttribute("aria-hidden", "true");
        logo.loading = "eager";
        logo.addEventListener("error", function () { logo.remove(); });
        return logo;
      }

      function selectStore(storeName) {
        storeInput.value = storeName;
        storeButtons.forEach(function (button) {
          button.setAttribute("aria-pressed", String(button.dataset.store === storeName));
        });
      }

      stores.forEach(function (store) {
        const button = document.createElement("button");
        button.type = "button";
        button.className = "store-option";
        button.dataset.store = store.name;
        button.setAttribute("aria-pressed", String(store.name === storeInput.value));
        const logo = createStoreLogo(store, "store-option-logo");
        if (logo) button.appendChild(logo);
        const label = document.createElement("span");
        label.textContent = store.name;
        button.appendChild(label);
        button.addEventListener("click", function () { selectStore(store.name); });
        storeButtons.push(button);
        storePicker.appendChild(button);
      });

      function loadItems() {
        try {
          if (localStorage.getItem(INITIALIZED_KEY) !== "true") {
            localStorage.setItem(STORAGE_KEY, "[]");
            localStorage.setItem(INITIALIZED_KEY, "true");
            return [];
          }
          const saved = localStorage.getItem(STORAGE_KEY);
          if (saved === null) return [];
          const parsed = JSON.parse(saved);
          if (!Array.isArray(parsed) || !parsed.every(isValidItem)) throw new Error("The saved list has an unexpected format.");
          return parsed.map(function (item) {
            const storeName = stores.some(function (store) { return store.name === item.store; }) ? item.store :
              (stores.some(function (store) { return store.name === item.category; }) ? item.category : "Other");
            return {
              id: item.id,
              name: item.name,
              quantity: item.quantity,
              store: storeName,
              bought: item.bought
            };
          });
        } catch (error) {
          window.setTimeout(function () { showToast("Your saved list couldn’t be read. A blank list is ready."); }, 0);
          return [];
        }
      }

      function isValidItem(item) {
        return item && typeof item.id === "string" && typeof item.name === "string" &&
          Number.isInteger(item.quantity) && item.quantity > 0 &&
          (typeof item.store === "string" || typeof item.category === "string") &&
          typeof item.bought === "boolean";
      }

      function saveItems() {
        try {
          localStorage.setItem(STORAGE_KEY, JSON.stringify(items));
        } catch (error) {
          showToast("Couldn’t save your list. Check your browser’s storage settings.");
        }
      }

      function showToast(message) {
        toastElement.textContent = message;
        toastElement.classList.add("show");
        window.clearTimeout(toastTimer);
        toastTimer = window.setTimeout(function () { toastElement.classList.remove("show"); }, 2800);
      }

      function render() {
        const boughtCount = items.filter(function (item) { return item.bought; }).length;
        const leftCount = items.length - boughtCount;
        const percent = items.length === 0 ? 0 : Math.round((boughtCount / items.length) * 100);
        document.getElementById("stat-bought").textContent = boughtCount;
        document.getElementById("stat-left").textContent = leftCount;
        document.getElementById("stat-total").textContent = items.length;
        document.getElementById("all-count").textContent = items.length;
        document.getElementById("left-count").textContent = leftCount;
        document.getElementById("bought-count").textContent = boughtCount;
        document.getElementById("progress-percent").textContent = percent + "%";
        document.getElementById("progress-fill").style.width = percent + "%";
        document.getElementById("progress-track").setAttribute("aria-valuenow", String(percent));
        document.getElementById("progress-label").textContent = items.length === 0 ? "Your progress" : boughtCount + " of " + items.length + " items picked up";

        const subtitle = document.getElementById("subtitle");
        if (items.length > 0 && leftCount === 0) subtitle.textContent = "Everything on the list is in your basket. Nice work!";
        else if (boughtCount > 0) subtitle.textContent = "You’re on your way. " + leftCount + (leftCount === 1 ? " item" : " items") + " left to find.";
        else subtitle.textContent = "Tap an item when it’s in your basket. You’ve got this.";

        listElement.replaceChildren();
        const matching = items.filter(function (item) {
          const matchesFilter = activeFilter === "all" || (activeFilter === "bought" ? item.bought : !item.bought);
          return matchesFilter && item.name.toLocaleLowerCase().includes(searchTerm);
        });

        stores.forEach(function (store) {
          const group = matching.filter(function (item) { return item.store === store.name; });
          if (group.length === 0) return;
          const section = document.createElement("section");
          section.className = "store-group";
          const heading = document.createElement("div");
          heading.className = "store-heading";
          const logo = createStoreLogo(store, "store-logo");
          if (logo) heading.appendChild(logo);
          const storeName = document.createElement("span");
          storeName.textContent = store.name;
          heading.appendChild(storeName);
          const count = document.createElement("span");
          count.className = "store-count";
          count.textContent = group.length + (group.length === 1 ? " item" : " items");
          heading.appendChild(count);
          section.appendChild(heading);
          group.forEach(function (item) { section.appendChild(createItemRow(item)); });
          listElement.appendChild(section);
        });

        if (matching.length === 0) {
          const empty = document.createElement("div");
          empty.className = "empty-state";
          const icon = document.createElement("div");
          icon.className = "empty-icon";
          icon.textContent = searchTerm ? "🔎" : (activeFilter === "bought" ? "🛍️" : "✨");
          const title = document.createElement("strong");
          const detail = document.createElement("span");
          if (searchTerm) {
            title.textContent = "Nothing found";
            detail.textContent = "Try another search, or add it to your list.";
          } else if (activeFilter === "bought") {
            title.textContent = "Nothing picked up yet";
            detail.textContent = "Check an item off and it’ll show up here.";
          } else if (activeFilter === "left" && items.length > 0) {
            title.textContent = "All done!";
            detail.textContent = "You’ve picked up everything on your list.";
          } else {
            title.textContent = "Your list is a blank canvas";
            detail.textContent = "Add your first grocery above and you’re off.";
          }
          empty.append(icon, title, detail);
          listElement.appendChild(empty);
        }
      }

      function createItemRow(item) {
        const row = document.createElement("div");
        row.className = "item-row" + (item.bought ? " is-bought" : "");
        const checkWrap = document.createElement("label");
        checkWrap.className = "check-wrap";
        const checkbox = document.createElement("input");
        checkbox.type = "checkbox";
        checkbox.checked = item.bought;
        checkbox.setAttribute("aria-label", (item.bought ? "Mark " + item.name + " as not picked up" : "Mark " + item.name + " as picked up"));
        checkbox.addEventListener("change", function () {
          item.bought = checkbox.checked;
          saveItems();
          render();
        });
        const checkmark = document.createElement("span");
        checkmark.className = "checkmark";
        checkmark.setAttribute("aria-hidden", "true");
        checkmark.innerHTML = '<svg viewBox="0 0 16 16" fill="none"><path d="m3.3 8.2 3 3 6.4-6.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>';
        checkWrap.append(checkbox, checkmark);
        const name = document.createElement("span");
        name.className = "item-name";
        name.textContent = item.name;
        const quantity = document.createElement("span");
        quantity.className = "quantity";
        quantity.textContent = item.quantity > 1 ? "× " + item.quantity : "";
        const remove = document.createElement("button");
        remove.className = "remove-button";
        remove.type = "button";
        remove.setAttribute("aria-label", "Remove " + item.name);
        remove.innerHTML = '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 7h16M10 11v6m4-6v6M6 7l1 14h10l1-14M9 7V4h6v3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>';
        remove.addEventListener("click", function () {
          items = items.filter(function (current) { return current.id !== item.id; });
          saveItems();
          render();
          showToast(item.name + " removed.");
        });
        row.append(checkWrap, name, quantity, remove);
        return row;
      }

      form.addEventListener("submit", function (event) {
        event.preventDefault();
        const name = itemInput.value.trim();
        const quantity = Number(quantityInput.value);
        if (!name) {
          itemInput.focus();
          return;
        }
        if (!Number.isInteger(quantity) || quantity < 1 || quantity > 99) {
          quantityInput.setCustomValidity("Enter a quantity from 1 to 99.");
          quantityInput.reportValidity();
          quantityInput.addEventListener("input", function clearQuantityError() {
            quantityInput.setCustomValidity("");
            quantityInput.removeEventListener("input", clearQuantityError);
          });
          return;
        }
        items.push({
          id: window.crypto && typeof window.crypto.randomUUID === "function" ? window.crypto.randomUUID() : String(Date.now()) + Math.random().toString(16).slice(2),
          name: name,
          quantity: quantity,
          store: storeInput.value,
          bought: false
        });
        activeFilter = "all";
        searchTerm = "";
        searchInput.value = "";
        document.querySelectorAll(".filter-button").forEach(function (button) {
          button.setAttribute("aria-pressed", String(button.dataset.filter === "all"));
        });
        saveItems();
        render();
        form.reset();
        quantityInput.value = "1";
        selectStore("Lidl");
        itemInput.focus();
        showToast(name + " added to your list.");
      });

      document.querySelectorAll(".filter-button").forEach(function (button) {
        button.addEventListener("click", function () {
          activeFilter = button.dataset.filter;
          document.querySelectorAll(".filter-button").forEach(function (filterButton) {
            filterButton.setAttribute("aria-pressed", String(filterButton === button));
          });
          render();
        });
      });

      searchInput.addEventListener("input", function () {
        searchTerm = searchInput.value.trim().toLocaleLowerCase();
        render();
      });

      function clearList() {
        items = [];
        activeFilter = "all";
        searchTerm = "";
        searchInput.value = "";
        document.querySelectorAll(".filter-button").forEach(function (button) {
          button.setAttribute("aria-pressed", String(button.dataset.filter === "all"));
        });
        saveItems();
        render();
      }

      document.getElementById("export-list").addEventListener("click", function () {
        const backup = new Blob([JSON.stringify({ version: 1, items: items }, null, 2)], { type: "application/json" });
        const downloadUrl = URL.createObjectURL(backup);
        const link = document.createElement("a");
        link.href = downloadUrl;
        link.download = "gather-backup-" + new Date().toISOString().slice(0, 10) + ".json";
        document.body.appendChild(link);
        link.click();
        link.remove();
        window.setTimeout(function () { URL.revokeObjectURL(downloadUrl); }, 1000);
        showToast("Backup exported. Keep the JSON file somewhere safe.");
      });

      const backupFileInput = document.getElementById("backup-file");
      document.getElementById("import-list").addEventListener("click", function () {
        backupFileInput.click();
      });

      backupFileInput.addEventListener("change", function () {
        const file = backupFileInput.files && backupFileInput.files[0];
        if (!file) return;
        const reader = new FileReader();
        reader.addEventListener("load", function () {
          try {
            const backup = JSON.parse(String(reader.result));
            if (!backup || backup.version !== 1 || !Array.isArray(backup.items) || !backup.items.every(isValidItem)) {
              throw new Error("The backup file has an unexpected format.");
            }
            if (items.length > 0 && !window.confirm("Importing this backup will replace your current list. Continue?")) return;
            const restoredItems = backup.items.map(function (item) {
              const storeName = stores.some(function (store) { return store.name === item.store; }) ? item.store :
                (stores.some(function (store) { return store.name === item.category; }) ? item.category : "Other");
              return {
                id: item.id,
                name: item.name,
                quantity: item.quantity,
                store: storeName,
                bought: item.bought
              };
            });
            localStorage.setItem(STORAGE_KEY, JSON.stringify(restoredItems));
            localStorage.setItem(INITIALIZED_KEY, "true");
            items = restoredItems;
            activeFilter = "all";
            searchTerm = "";
            searchInput.value = "";
            document.querySelectorAll(".filter-button").forEach(function (button) {
              button.setAttribute("aria-pressed", String(button.dataset.filter === "all"));
            });
            render();
            showToast("Backup restored.");
          } catch (error) {
            showToast("Couldn’t restore the backup. Check that it’s valid and browser storage is enabled.");
          } finally {
            backupFileInput.value = "";
          }
        });
        reader.addEventListener("error", function () {
          backupFileInput.value = "";
          showToast("Couldn’t read that backup file. Please try again.");
        });
        reader.readAsText(file);
      });

      document.getElementById("clear-list").addEventListener("click", function () {
        clearList();
        showToast("Your list has been cleared.");
      });

      document.getElementById("new-list").addEventListener("click", function () {
        if (items.length > 0 && !window.confirm("Start a fresh list? Your current items will be cleared.")) return;
        clearList();
        showToast("A fresh list is ready.");
      });

      const todayElement = document.getElementById("today");
      const dateFormatter = new Intl.DateTimeFormat(undefined, { weekday: "short", month: "short", day: "numeric" });
      let dateTimer;
      function updateToday() {
        const now = new Date();
        todayElement.textContent = dateFormatter.format(now);
        const nextDay = new Date(now.getFullYear(), now.getMonth(), now.getDate() + 1);
        window.clearTimeout(dateTimer);
        dateTimer = window.setTimeout(updateToday, nextDay.getTime() - now.getTime() + 50);
      }
      document.addEventListener("visibilitychange", function () {
        if (!document.hidden) updateToday();
      });
      updateToday();
      render();
    }());
  </script>
</body>
</html>
